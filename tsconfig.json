{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    "module": "commonjs",     // <-- เปลี่ยนเป็น commonjs เพื่อให้ ts-node ทำงานกับ NestJS ได้ง่ายสุด
    "target": "es2021",       // <-- NestJS แนะนำให้ใช้ es2021
    
    // NestJS Required Options (ขาดไม่ได้สำหรับ Dependency Injection)
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "esModuleInterop": true,   // <-- ช่วยให้ import library ต่างๆ ได้ง่ายขึ้น
    "types": ["node"]
  }
}